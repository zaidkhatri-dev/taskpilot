{
  "name": "@repo/contracts",
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "exports": {
    "./request/*": {
      "types": "./src/request/*.ts"
    },
    "./response/*": {
      "types": "./src/response/*.ts"
    },
    "./miscellaneous/*": {
      "types": "./src/miscellaneous/*.ts",
      "default": "./dist/miscellaneous/*.js"
    }
  },
  "scripts": {
    "build": "tsc --rootDir ./src --outDir ./dist",
    "typecheck": "tsc --noEmit"
  },
  "type": "module"
}
