{
  "name": "@repo/contracts",
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "exports": {
    "./request": {
      "import": {
        "types": "./src/request.ts",
        "default": "./dist/request.js"
      }
    },
    "./response": {
      "import": {
        "types": "./src/response.ts",
        "default": "./dist/response.js"
      }
    },
    "./other": {
      "import": {
        "types": "./src/other.ts",
        "default": "./dist/other.js"
      }
    }
  },
  "scripts": {
    "build": "tsc --rootDir ./src --outDir ./dist",
    "typecheck": "tsc --noEmit"
  },
  "type": "module"
}